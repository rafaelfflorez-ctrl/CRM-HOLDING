# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# Clave secundaria opcional por si la principal supera cuota 429:
GEMINI_API_KEY_2=
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_FALLBACK_MODELS="gemini-3.7-flash,gemini-flash-latest"

# ASESOR IA (solo texto) — proveedor configurable ("gemini" o "openai" para Groq, DeepSeek, OpenRouter, etc.)
AI_PROVIDER="gemini"
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
OPENAI_API_KEY=
OPENAI_MODEL="llama-3.3-70b-versatile"

# SUPABASE CONFIGURATION (Optional for cloud sync):
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
